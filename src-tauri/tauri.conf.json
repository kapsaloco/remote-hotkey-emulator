{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emulator Remote",
  "version": "1.0.0",
  "identifier": "com.emulatorremote.desktop",
  "build": {
    "beforeDevCommand": "npm run build:tauri-ui",
    "beforeBuildCommand": "npm run build:tauri-ui",
    "frontendDist": "../dist/tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "Emulator Remote", "url": "index.html", "create": false,
      "width": 500, "height": 780, "minWidth": 420, "minHeight": 620,
      "backgroundColor": "#02040d", "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'",
      "capabilities": ["desktop"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../assets/icon.ico"]
  }
}
